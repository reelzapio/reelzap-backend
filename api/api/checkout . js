const https = require('https');
function setCors(res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
}
function stripeRequest(path, body, secretKey) {
  return new Promise((resolve, reject) => {
    const postData = new URLSearchParams(body).toString();
    const req = https.request({
      hostname: 'api.stripe.com',
      path, method: 'POST',
      headers: {
        'Authorization': `Bearer ${secretKey}`,
        'Content-Type': 'application/x-www-form-urlencoded',
        'Content-Length': Buffer.byteLength(postData)
      }
    }, (res) => {
      let data = '';
      res.on('data', chunk => data += chunk);
      res.on('end', () => {
        try { resolve({ ok: res.statusCode < 400, data: JSON.parse(data) }); }
        catch { resolve({ ok: false, data: {} }); }
      });
    });
    req.on('error', reject);
    req.write(postData);
    req.end();
  });
}
const PRICE_IDS = {
  pro_yearly: process.env.STRIPE_PRICE_PRO_YEARLY || '',
  pro_monthly: process.env.STRIPE_PRICE_PRO_MONTHLY || '',
  expert_yearly: process.env.STRIPE_PRICE_EXPERT_YEARLY || '',
  expert_monthly: process.env.STRIPE_PRICE_EXPERT_MONTHLY || '',
  business_yearly: process.env.STRIPE_PRICE_BIZ_YEARLY || '',
  business_monthly: process.env.STRIPE_PRICE_BIZ_MONTHLY || ''
};
module.exports = async (req, res) => {
  setCors(res);
  if (req.method === 'OPTIONS') return res.status(200).end();
  if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });
  let body = '';
  await new Promise(resolve => { req.on('data', c => body += c); req.on('end', resolve); });
  let parsed;
  try { parsed = JSON.parse(body); } catch { return res.status(400).json({ error: 'Invalid JSON' }); }
  const { plan, billing, email } = parsed;
  const secretKey = process.env.STRIPE_SECRET_KEY;
  if (!secretKey) return res.status(500).json({ error: 'Stripe not configured' });
  const priceId = PRICE_IDS[`${plan}_${billing}`];
  if (!priceId) return res.status(400).json({ error: `Price not configured for ${plan}_${billing}` });
  const origin = req.headers.origin || 'https://reelzap.netlify.app';
  try {
    const session = await stripeRequest('/v1/checkout/sessions', {
      'payment_method_types[]': 'card',
      'mode': 'subscription',
      'customer_email': email || '',
      'line_items[0][price]': priceId,
      'line_items[0][quantity]': '1',
      'subscription_data[trial_period_days]': '7',
      'success_url': `${origin}/dashboard.html?payment=success`,
      'cancel_url': `${origin}/reelzap.html#pricing`,
      'allow_promotion_codes': 'true'
    }, secretKey);
    if (!session.ok) return res.status(400).json({ error: session.data.error?.message || 'Stripe error' });
    return res.status(200).json({ id: session.data.id, url: session.data.url });
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
};
